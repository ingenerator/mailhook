{
    "name": "ingenerator/mailhook",
    "description": "Collects email from a local postfix server so you can inspect, assert and otherwise mess around with emails sent during development.",
    "homepage": "https://github.com/ingenerator/mailhook",
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "inGenerator",
            "homepage": "https://www.ingenerator.com/"
        },
        {
            "name": "Andrew Coulton",
            "email": "andrew@ingenerator.com",
            "homepage": "https://www.ingenerator.com"
        }
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0"
    },
    "require-dev": {
        "phpspec/phpspec": "dev-main as 7.x-dev",
        "phpspec/prophecy": "~1.1",
        "mikey179/vfsstream": "^1.6.11"
    },
    "support": {
        "issues": "https://github.com/ingenerator/mailhook/issues",
        "source": "https://github.com/ingenerator/mailhook"
    },
    "autoload": {
        "psr-0": {
            "Ingenerator\\Mailhook": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "spec\\": "spec"
        }
    },
    "bin": [],
    "config": {
        "preferred-install": "dist"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.1.x-dev"
        }
    }
}
